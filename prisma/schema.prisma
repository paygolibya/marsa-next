// Prisma schema for the Marsa/Rifqa backend.
//
// This is a direct translation of the original better-sqlite3 schema in
// marsa-backend/src/db/index.js — same tables, same columns, same
// relationships and constraints. Field names are camelCase on the Prisma
// side and mapped back to the original snake_case column names via @map,
// so a raw SQL migration from the old SQLite file would line up cleanly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id            String   @id @default(cuid())
  name          String
  nameAr        String
  slug          String   @unique
  description   String
  descriptionAr String
  category      String   @default("all")
  price         Int      @default(0)
  currency      String   @default("LYD")
  billingType   String   @default("free")
  thumbnail     String
  previewUrl    String
  features      Json
  componentPath String?
  defaultColors Json?
  usageCount    Int      @default(0)
  rating        Float    @default(4.5)
  reviews       Int      @default(0)
  featured      Boolean  @default(false)
  isNew         Boolean  @default(false)
  active        Boolean  @default(true)

  stores         Store[]
  customizations TemplateCustomization[]
  reviewsData    TemplateReview[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

model TemplateCustomization {
  id               String  @id @default(cuid())
  storeId          String  @unique @map("store_id")
  templateId       String? @map("template_id")
  primaryColor     String  @default("#0066cc") @map("primary_color")
  secondaryColor   String  @default("#f0f0f0") @map("secondary_color")
  accentColor      String? @map("accent_color")
  logo             String?
  favicon          String?
  tagline          String?
  description      String?
  headerStyle      String  @default("standard") @map("header_style")
  footerStyle      String  @default("standard") @map("footer_style")
  // Header identity controls — whether the logo/name render at all, and
  // the logo's rendered size ("sm" | "md" | "lg" | "xl"). A bigger logo
  // does NOT grow the header bar itself — see resolveLogoSizePx() and the
  // absolute-positioned <StorefrontLogo> it feeds, which lets the logo
  // overflow the bar's own fixed height instead of stretching it.
  showLogo         Boolean @default(true) @map("show_logo")
  showStoreName    Boolean @default(true) @map("show_store_name")
  logoSize         String  @default("md") @map("logo_size")
  // Overrides the storefront's default heading/body text color/size
  // (Tailwind's harbor navy, default size) when set — null color means
  // "use the template's own default", not black/unset.
  textColor        String? @map("text_color")
  textSize         String  @default("md") @map("text_size")
  // A full-width banner image shown between the header and the page
  // content, plus its rendered height ("sm" | "md" | "lg").
  coverImage       String? @map("cover_image")
  coverImageSize   String  @default("md") @map("cover_image_size")
  // BoldTemplate's own full-bleed colored hero block (store name + tagline
  // + description on a primaryColor background) — the only template with
  // this concept today. Off just skips rendering it; size controls its
  // vertical padding.
  heroEnabled      Boolean @default(true) @map("hero_enabled")
  heroSize         String  @default("md") @map("hero_size")
  // Which side of the header the cart button sits on — independent of
  // headerStyle/logo placement (Modern/Bold only; see cartPosition usage
  // in those templates). "left" matches the original pre-existing layout,
  // so this default changes nothing for stores created before this field.
  cartPosition     String  @default("left") @map("cart_position")
  // Deprecated in favor of StoreSection.enabled (per-section, not one flag
  // per section type here) — same fallback-source role as sectionOrder below.
  showNewsletter   Boolean @default(true) @map("show_newsletter")
  showReviews      Boolean @default(true) @map("show_reviews")
  showTestimonials Boolean @default(false) @map("show_testimonials")
  showSocialProof  Boolean @default(true) @map("show_social_proof")
  // Deprecated in favor of StoreSection (see that model's comment) — kept,
  // not dropped, as the fallback source when a store has no StoreSection
  // rows yet (backfill not run / a store created in the gap). New code
  // should read/write StoreSection, not these.
  sectionOrder     String[] @default(["stats", "products", "testimonials", "newsletter"]) @map("section_order")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template_customizations")
}

model TemplateReview {
  id           String  @id @default(cuid())
  templateId   String  @map("template_id")
  merchantId   String? @map("merchant_id")
  rating       Int
  reviewText   String? @map("review_text")
  reviewTextAr String? @map("review_text_ar")
  helpful      Int     @default(0)
  notHelpful   Int     @default(0) @map("not_helpful")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template_reviews")
}

model Merchant {
  id                     String    @id @default(cuid())
  name                   String
  phone                  String    @unique
  passwordHash           String    @map("password_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  subscriptionTier       String?   @default("basic") @map("subscription_tier")
  subscriptionStatus     String    @default("inactive") @map("subscription_status")
  subscriptionStartDate  DateTime? @map("subscription_start_date")
  subscriptionEndDate    DateTime? @map("subscription_end_date")
  // Which billing period (1/3/12 months) the CURRENT subscriptionEndDate
  // was purchased at — see Payment.periodMonths for the record on each
  // individual payment; this is just "what the merchant is on right now",
  // for dashboard/renewal display. Null for merchants on the free trial
  // or predating this field.
  subscriptionPeriodMonths Int?    @map("subscription_period_months")
  // Set once at registration for new signups (see /api/auth/register).
  // subscriptionEndDate is the one field that actually gates access — this
  // is kept alongside it purely so the UI/admin can tell "still on the
  // free trial" apart from "a real paid period," even after a genuine
  // payment later overwrites subscriptionEndDate to something later.
  trialEndsAt            DateTime? @map("trial_ends_at")
  directWireEnabled      Boolean   @default(true) @map("direct_wire_enabled")
  receiptUploadEnabled   Boolean   @default(true) @map("receipt_upload_enabled")
  codEnabled             Boolean   @default(true) @map("cod_enabled")
  // Name kept from the DPay era for column-rename safety on a live DB —
  // this now gates wallet payment (Moamalat) generally, not DPay
  // specifically. See getCheckoutPaymentMethods().dpay.
  dpayEnabled            Boolean   @default(false) @map("dpay_enabled")
  allowMultiplePaymentMethods Boolean @default(false) @map("allow_multiple_payment_methods")
  apiAccessEnabled       Boolean   @default(false) @map("api_access_enabled")
  selectedPaymentMethod  String?   @map("selected_payment_method")
  // Legacy: DPay's per-merchant bearer token. Moamalat uses app-wide env
  // credentials instead (MOAMALAT_MERCHANT_ID/TERMINAL_ID/SECRET_KEY), so
  // this column is frozen historical data — never read or written by new
  // code.
  dpayApiToken           String?   @map("dpay_api_token")

  phoneVerified          Boolean   @default(false) @map("phone_verified")
  otpCodeHash            String?   @map("otp_code_hash")
  otpExpiresAt           DateTime? @map("otp_expires_at")
  otpSentAt              DateTime? @map("otp_sent_at")
  otpAttempts            Int       @default(0) @map("otp_attempts")
  registrationIp         String?   @map("registration_ip")

  stores Store[]
  payments Payment[]
  payouts Payout[]
  commissions Commission[]
  supportConversations SupportConversation[]
  bugReports BugReport[]
  impersonationSessions ImpersonationSession[]

  @@map("merchants")
}

// Failed login attempts only, by IP — the DB-backed rate-limit counter for
// POST /api/auth/login, same "must survive across invocations" reasoning
// as Merchant.registrationIp's counter for registration (this runs on
// serverless, so an in-memory counter resets on every cold start). Only
// failures are logged (a successful login isn't a brute-force signal), so
// the count naturally ages out of the lockout window without needing an
// explicit reset on success.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@map("login_attempts")
}

// AI merchant-support chat (Claude, tool-use grounded in this merchant's
// own real data — see src/lib/support/). One conversation persists across
// page reloads; a merchant can escalate a real platform bug mid-conversation
// (see BugReport) rather than the agent guessing or making something up.
model SupportConversation {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]
  bugReports BugReport[]

  @@index([merchantId])
  @@map("support_conversations")
}

model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("support_messages")
}

// A real platform issue the support agent couldn't resolve by answering —
// escalated for a human developer to investigate (see src/app/admin/escalations).
// Deliberately NOT auto-fixed: no agent in this app ever pushes a code
// change to production unattended.
model BugReport {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  storeId        String?  @map("store_id")
  conversationId String?  @map("conversation_id")
  summary        String
  details        String   @db.Text
  status         String   @default("open") // open | investigating | fixed | wont_fix
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  merchant     Merchant             @relation(fields: [merchantId], references: [id])
  conversation SupportConversation? @relation(fields: [conversationId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@map("bug_reports")
}

// A record that an admin briefly acted as a merchant (see
// signImpersonationToken in lib/auth.ts) — logged at start only, no
// endedAt: the 2h token expiry is the real session bound, and depending on
// a reliable "exit" call would miss every session where the admin just
// closed the tab. adminId is deliberately a bare String, not a second
// relation to Merchant — an admin is just another merchant row
// (isAdminMerchantId), and a second FK to the same table would be
// relation-ambiguous with `merchant` below.
model ImpersonationSession {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  merchantId String   @map("merchant_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([adminId])
  @@map("impersonation_sessions")
}

model Payment {
  id                String    @id @default(cuid())
  merchantId        String    @map("merchant_id")
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  tier              String // legacy — "standard" for every new payment now that there's one plan; kept non-null since old rows have real basic/professional/advanced values
  periodMonths      Int       @default(1) @map("period_months") // 1, 3, or 12 — which billing period this payment is for
  amount            Int // whole LYD, NOT cents — existing convention on this model, kept as-is rather than migrated
  currency          String    @default("LYD")
  status            String    @default("pending") // 'pending' | 'approved' | 'rejected'
  method            String    @default("bank_transfer") @map("method") // 'bank_transfer' | 'dpay' (legacy) | 'moamalat'
  receiptFile       String?   @map("receipt_file")
  receiptUploadedAt DateTime? @map("receipt_uploaded_at")
  approvedAt        DateTime? @map("approved_at")
  approvedBy        String?   @map("approved_by") // admin merchantId for a manual approval; null for an automatic gateway confirmation
  rejectionReason   String?   @map("rejection_reason")

  // Legacy DPay session tracking — frozen historical data, see the
  // matching comment on Order above.
  dpaySessionId String? @unique @map("dpay_session_id")
  dpayPayMethod String? @map("dpay_pay_method")
  dpayFeeCents  Int?    @map("dpay_fee_cents")

  // Direct Moamalat LightBox tracking — see moamalat-subscription.ts.
  // MerchantReference sent to Moamalat is always this Payment's own id.
  moamalatSystemReference  String? @map("moamalat_system_reference")
  moamalatNetworkReference String? @map("moamalat_network_reference")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

model Store {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  name           String
  slug           String   @unique
  theme          String   @default("souk")
  courier        String   @default("vanex") // 'vanex' — Sabil/Shaheen removed, no real integration yet
  codEnabled     Boolean  @default(true) @map("cod_enabled")
  // What kind of store this is — started as a single isDigital boolean
  // (one real merchant selling Snapchat filters: no physical delivery, so
  // skip Vanex and auto-confirm every order instead of waiting on a
  // courier step that will never happen) and generalized from there:
  //   physical — default; ships via Vanex, courier dispatch on order.
  //   digital  — no delivery at all; same auto-confirm behavior as before.
  //   booking  — appointment slot instead of an address; see
  //              bookingSlotMinutes/bookingWorkingHours below and
  //              Order.scheduledStartAt/scheduledEndAt.
  //   rental   — a date range instead of an address; priceCents on the
  //              product IS the daily rate, total = rate * days * qty.
  //   showcase — catalog only, no checkout at all; buyers send an Inquiry
  //              (see the Inquiry model) instead of placing an order.
  // Read everywhere order creation/checkout branches on store kind — see
  // src/app/api/orders/handler.ts and src/lib/payment/moamalat-order.ts.
  type           String   @default("physical")
  walletProvider String?  @map("wallet_provider") // e.g. 'anis' (DPay aggregator merchant)

  // Booking-only (store.type === "booking"): a store-wide (not per-product)
  // appointment grid. bookingWorkingHours is a weekly schedule keyed by
  // day-of-week as a string "0" (Sunday) through "6" (Saturday), e.g.
  // {"1":{"open":"09:00","close":"17:00"}} — a missing/null day means
  // closed. No per-date overrides/holidays, no timezone handling (single-
  // timezone merchants only). See
  // src/app/api/stores/public/[slug]/availability/handler.ts for how this
  // turns into actual open slots for a given date, and the partial unique
  // index on Order below for how double-booking the same slot is
  // prevented.
  bookingSlotMinutes  Int?  @map("booking_slot_minutes")
  bookingWorkingHours Json? @map("booking_working_hours")

  currency       String   @default("LYD")
  templateId     String?  @map("template_id")
  createdAt      DateTime @default(now()) @map("created_at")

  aboutText      String? @map("about_text")
  returnPolicy   String? @map("return_policy")
  shippingPolicy String? @map("shipping_policy")
  businessHours  String? @map("business_hours")

  // Custom domain (e.g. www.merchant-shop.ly) — the {slug}.rifqa.ly
  // subdomain needs no DB field at all, `slug` already is it. Verification
  // is Vercel's own (via its Domains API, src/lib/domains/vercel-client.ts)
  // — customDomainVerified only ever reflects what Vercel itself confirms,
  // never set directly by application logic.
  customDomain         String?  @unique @map("custom_domain")
  customDomainVerified Boolean  @default(false) @map("custom_domain_verified")

  merchant       Merchant               @relation(fields: [merchantId], references: [id])
  template       Template?              @relation(fields: [templateId], references: [id])
  customization  TemplateCustomization?
  products       Product[]
  orders         Order[]
  coupons        Coupon[]
  newsletterSubscribers NewsletterSubscriber[]
  sections       StoreSection[]
  inquiries      Inquiry[]
  categories     Category[]
  bundles        Bundle[]
  upsells        Upsell[]
  customers      Customer[]
  pages          Page[]
  navMenuItems   NavMenuItem[]
  redirects      Redirect[]

  @@map("stores")
}

// Replaces TemplateCustomization's flat sectionOrder: String[] + the four
// show* booleans with a real, individually-configurable content model — one
// row per section instead of one shared array. `settings` is validated
// per-`type` by the Zod schemas in
// src/components/storefront/sections/schemas.ts (kept intentionally small:
// these sections stay data-driven — real orders/reviews/products — not
// merchant-authored CMS content; that's the seam future section types would
// plug into, not something Phase 1 needs).
//
// Additive-only migration (prisma/migrations/*_add_store_sections) — safe
// on live production data on its own. A one-time backfill script
// (prisma/scripts/backfill-store-sections.ts) populates this table from
// each store's existing sectionOrder/show* fields; until that's run for a
// given store (or for a store created in the gap before it runs), storefront
// rendering falls back to synthesizing sections in-memory from those legacy
// fields — see normalizeSectionOrder() — so the rollout order isn't required
// to be atomic. The legacy sectionOrder/show* columns are deliberately NOT
// dropped here — a later migration removes them once this table's been the
// live source for a while.
model StoreSection {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  type      String   // "stats" | "products" | "testimonials" | "newsletter" for now
  position  Int
  enabled   Boolean  @default(true)
  settings  Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, position])
  @@index([storeId])
  @@map("store_sections")
}

// Real capture behind the customizer's "عرض نموذج الاشتراك بالرسائل"
// toggle — previously a checkbox with nothing behind it at all.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@map("newsletter_subscribers")
}

// A merchant's flat list of product categories (not nested/hierarchical —
// deliberately simple, matching the small-catalog use case this platform
// targets). slug is used for the storefront filter's query param, unique
// per store (not globally, unlike Store.slug).
model Category {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  name      String
  slug      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  name       String
  // Free-text product details, separate from `name` — added because
  // merchants had nowhere else to put real marketing copy and were
  // stuffing entire paragraphs into `name` instead (confirmed live: a
  // product whose "name" was several sentences long), which broke every
  // layout built assuming a short title (card grids, the PDP heading).
  description String? @db.Text
  priceCents Int      @map("price_cents")
  // imageUrl is kept as images[0] — always written together, never a
  // second source of truth — so every existing call site that only knows
  // about a single image (storefront template cards, cart, order emails)
  // keeps working unchanged; only the product detail page and the editor
  // need the full gallery.
  imageUrl   String?  @map("image_url")
  images     String[] @default([])
  // `active` is ALSO auto-set to false by /api/orders when stock hits 0
  // (see the stock-decrement transaction) — not only by a merchant's own
  // delete. deletedAt is the one unambiguous "the merchant deleted this"
  // signal, so the merchant's own product list (GET /by-store) can filter
  // out deleted products while still showing out-of-stock ones (which the
  // merchant needs to see, to restock). The public storefront listing
  // still just checks active — a buyer should never see either case.
  active     Boolean   @default(true)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  trackInventory    Boolean @default(false) @map("track_inventory")
  stockQty          Int     @default(0) @map("stock_qty")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")

  // Option TYPES this product offers, e.g.
  // [{"name":"الحجم","values":["S","M","L"]},{"name":"اللون","values":["أحمر","أزرق"]}]
  // — null/empty means no variants, same as today. The actual purchasable
  // combinations are ProductVariant rows; this is only the merchant's
  // editable option definitions used to generate/regenerate them.
  variantOptions Json? @map("variant_options")

  // Single category per product (not many-to-many) — deliberately simple,
  // matching how small merchants actually organize a catalog (a flat list
  // of categories, one per product), not a tagging system. Nullable:
  // uncategorized is a valid, common state, not an error.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // SEO overrides for the product detail page's <title>/meta description —
  // null means the PDP falls back to the product name / description, same
  // as before these existed.
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  // What the merchant actually paid, purely for their own margin math —
  // never exposed on the storefront or to buyers, only on the merchant's
  // own product form/list.
  costPriceCents  Int?    @map("cost_price_cents")

  store       Store            @relation(fields: [storeId], references: [id])
  orderItems  OrderItem[]
  reviews     ProductReview[]
  variants    ProductVariant[]
  inquiries   Inquiry[]
  bundleItems BundleItem[]
  upsellsAsTrigger Upsell[] @relation("UpsellTrigger")
  upsellsAsOffered Upsell[] @relation("UpsellOffered")

  // Postgres doesn't auto-index foreign-key scalar columns (unlike MySQL) —
  // every merchant-facing product list filters by storeId, so without this
  // it's a full table scan once the platform has real row counts.
  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  // e.g. {"الحجم":"M","اللون":"أحمر"} — one concrete combination of the
  // parent product's variantOptions.
  options   Json
  // null = inherit Product.priceCents; set only when this specific
  // combination costs more/less than the base product.
  priceCents Int?   @map("price_cents")
  stockQty  Int     @default(0) @map("stock_qty")
  sku       String?
  active    Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

// A showcase store (store.type === "showcase", e.g. a car exhibition) has
// no checkout at all — no price-based purchase, no payment, no stock
// decrement. A buyer who wants a product sends an Inquiry instead; the
// merchant follows up with them directly (phone call, in person), outside
// this system. productId is nullable (not every inquiry has to reference
// a specific product, and a referenced product can later be deleted
// without losing the inquiry's own record).
model Inquiry {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  productId  String?  @map("product_id")
  buyerName  String   @map("buyer_name")
  buyerPhone String   @map("buyer_phone")
  message    String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("inquiries")
}

model Order {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  buyerName         String   @map("buyer_name")
  buyerPhone        String   @map("buyer_phone")
  buyerEmail        String?  @map("buyer_email")
  buyerCity         String   @map("buyer_city")
  buyerAddress      String   @map("buyer_address")
  paymentMethod     String   @map("payment_method") // 'cod' | 'wallet'
  paymentStatus     String   @map("payment_status") // 'pending' | 'paid' | 'failed'
  courierTrackingId String?  @map("courier_tracking_id")
  status            String   @default("pending") // pending -> confirmed -> shipped -> delivered -> cancelled | refunded
  productSubtotalCents Int   @default(0) @map("product_subtotal_cents")
  discountCents     Int      @default(0) @map("discount_cents")
  couponCode        String?  @map("coupon_code")
  totalCents        Int      @map("total_cents")
  shippingCents     Int      @default(0) @map("shipping_cents")
  courierStatus     String?  @map("courier_status") // raw courier-reported status, e.g. accepted/delivered/failed_delivery/returned
  courierStatusAt   DateTime? @map("courier_status_at")
  courierNote       String?  @map("courier_note") // failure/return reason from the courier
  createdAt         DateTime @default(now()) @map("created_at")

  // Legacy DPay wallet payment tracking — DPay (the aggregator) was
  // removed in favor of a direct Moamalat integration; these three
  // columns are frozen historical data for orders paid before that
  // switch, never written to by new code. See moamalatSystemReference
  // etc. below for the current integration.
  dpaySessionId String? @unique @map("dpay_session_id")
  dpayPayMethod String? @map("dpay_pay_method") // edfali | sadad | masrefypay | yousrpay | saharapay | mobicash | moamalat
  dpayFeeCents  Int?    @map("dpay_fee_cents") // DPay's own fee, separate from Rifqa's commission

  // Direct Moamalat LightBox payment tracking — set once Moamalat's
  // completeCallback or server notification confirms the transaction
  // (src/lib/payment/moamalat-client.ts). paymentStatus flips from
  // pending to paid/failed only via src/lib/payment/moamalat-order.ts,
  // called from either the client-relayed complete callback or Moamalat's
  // own server notification (whichever confirms first) — never written
  // directly anywhere else. MerchantReference sent to Moamalat is always
  // this Order's own id, so no separate correlation column is needed.
  moamalatSystemReference  String? @map("moamalat_system_reference")
  moamalatNetworkReference String? @map("moamalat_network_reference")

  // A booking appointment slot (store.type "booking") or a rental period
  // (store.type "rental") — one pair of columns, two meanings, set only
  // for those two store types. scheduledKind records WHICH meaning this
  // row has ("booking" | "rental" | null) — needed because only booking
  // slots must be unique per store: a partial unique index on
  // (storeId, scheduledStartAt) WHERE scheduledKind = 'booking' (hand-
  // written migration, see its own comment — Prisma's schema language
  // can't express a partial WHERE) prevents double-booking the same
  // appointment atomically at the DB level, the same way the existing
  // stock-decrement guard prevents overselling. Two rental orders
  // legitimately CAN share a start date, so the index must not catch
  // them too — that's what scheduledKind filters on. Never trust a
  // client-sent scheduledEndAt; it's always recomputed server-side
  // (booking: scheduledStartAt + Store.bookingSlotMinutes; rental: from
  // the buyer's own chosen end date, but the day-count/total is still
  // recomputed server-side).
  scheduledStartAt DateTime? @map("scheduled_start_at")
  scheduledEndAt   DateTime? @map("scheduled_end_at")
  scheduledKind    String?   @map("scheduled_kind") // 'booking' | 'rental' | null

  // Automatic payout tracking — set the moment the real-time trigger (or
  // its daily-cron backstop) calculates this order's commission. Denormalized
  // copies of the linked Commission row so the order itself is queryable
  // without a join; see src/lib/payment/payout-processor.ts.
  rifqaCommissionCents Int?      @map("rifqa_commission_cents")
  merchantPayoutCents  Int?      @map("merchant_payout_cents")
  payoutStatus         String?   @map("payout_status") // null (not yet calculated) | 'ready_for_transfer' | 'transferred'
  payoutCalculatedAt   DateTime? @map("payout_calculated_at")
  payoutTransferredAt  DateTime? @map("payout_transferred_at")

  vanexAreaId String?     @map("vanex_area_id")
  vanexArea   VanexArea?  @relation(fields: [vanexAreaId], references: [id], onDelete: SetNull)

  // Internal record only — no Moamalat refund/void API exists (see
  // docs/moamalat.md), so this does not itself reverse any money. It marks
  // intent/record for the merchant/admin; a wallet refund still requires a
  // manual bank-side reversal outside this system. See
  // src/app/api/orders/[id]/refund/route.ts for what this does and does
  // NOT do to an already-batched Commission/Payout.
  refundedAt   DateTime? @map("refunded_at")
  refundReason String?   @map("refund_reason")

  store      Store           @relation(fields: [storeId], references: [id])
  items      OrderItem[]
  reviews    ProductReview[]
  commission Commission?

  // Compound index covers both "all orders for this store" (by-store,
  // track) and "this store's orders since <date>" (analytics) — the two
  // hot query shapes against this table. No index existed on Order at all
  // before this, meaning every one of those was a full table scan.
  @@index([storeId, createdAt])
  @@map("orders")
}

// ============================================
// PAYOUTS — automatic commission/payout tracking
//
// Only orders where Rifqa actually held the money are eligible: wallet
// (DPay) orders with paymentStatus "paid". COD cash is collected by the
// courier directly from the buyer and never touches Rifqa's account, so
// there is nothing to pay a merchant out of for a COD order through this
// system — see src/lib/payment/commission.ts for the exact filter.
//
// Commission = one row per eligible order, created automatically the
// moment it's marked delivered (real-time trigger) or, as a backstop, by
// the daily cron. Payout = a weekly batch of Commission rows for one
// merchant, created by the Friday cron and manually transferred by an
// admin — see src/lib/payment/payout-processor.ts.
// ============================================

model Commission {
  id                   String    @id @default(cuid())
  orderId              String    @unique @map("order_id")
  merchantId           String    @map("merchant_id")
  payoutId             String?   @map("payout_id")
  orderTotalCents      Int       @map("order_total_cents")
  rifqaCommissionCents Int       @map("rifqa_commission_cents")
  merchantPayoutCents  Int       @map("merchant_payout_cents")
  status               String    @default("calculated") @map("status") // 'calculated' | 'paid'
  calculatedAt         DateTime  @default(now()) @map("calculated_at")
  paidAt               DateTime? @map("paid_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payout   Payout?  @relation(fields: [payoutId], references: [id])

  @@index([merchantId])
  @@index([payoutId])
  @@map("commissions")
}

model Payout {
  id                String    @id @default(cuid())
  merchantId        String    @map("merchant_id")
  periodStart       DateTime  @map("period_start")
  periodEnd         DateTime  @map("period_end")
  orderCount        Int       @map("order_count")
  totalSalesCents   Int       @map("total_sales_cents")
  commissionCents   Int       @map("commission_cents")
  amountCents       Int       @map("amount_cents") // what the merchant actually receives
  status            String    @default("ready_for_transfer") @map("status") // 'ready_for_transfer' | 'transferred'
  transferredAt     DateTime? @map("transferred_at")
  transferredBy     String?   @map("transferred_by") // admin merchantId who clicked transfer
  transferReference String?   @map("transfer_reference") // bank ref / note for the manual transfer
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([merchantId])
  @@map("payouts")
}

model CronLog {
  id              String   @id @default(cuid())
  jobName         String   @map("job_name") // 'process-deliveries' | 'weekly-payouts'
  status          String   // 'success' | 'failed'
  ordersProcessed Int      @default(0) @map("orders_processed")
  payoutsCreated  Int      @default(0) @map("payouts_created")
  errorMessage    String?  @map("error_message")
  durationMs      Int?     @map("duration_ms")
  executedAt      DateTime @default(now()) @map("executed_at")

  @@map("cron_logs")
}

model Coupon {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  code          String
  discountType  String    @map("discount_type") // 'percent' | 'fixed'
  discountValue Int       @map("discount_value") // percent: 1-100; fixed: cents
  minOrderCents Int?      @map("min_order_cents")
  maxUsage      Int?      @map("max_usage")
  usageCount    Int       @default(0) @map("usage_count")
  active        Boolean   @default(true)
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@map("coupons")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  orderId    String   @map("order_id")
  buyerName  String   @map("buyer_name")
  buyerPhone String   @map("buyer_phone") // spam-gate re-check only, never returned by the public GET
  rating     Int
  reviewText String?  @map("review_text")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@map("product_reviews")
}

// ============================================
// VANEX SHIPPING INTEGRATION
// ============================================

model VanexCity {
  id         String   @id @default(cuid())
  vanexId    Int      @unique @map("vanex_id")
  name       String
  priceCents Int      @map("price_cents")
  code       String
  branch     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  areas VanexArea[]

  @@map("vanex_cities")
}

model VanexArea {
  id         String   @id @default(cuid())
  vanexId    Int      @unique @map("vanex_id")
  cityId     String   @map("city_id")
  name       String
  priceCents Int      @map("price_cents")
  code       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  city   VanexCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([cityId])
  @@map("vanex_areas")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  // Nullable: a bundle line (see bundleId below) has no single product of
  // its own — it's recorded as one row with productId null, rather than
  // exploded into one row per component, so order totals never depend on
  // splitting a bundle's fixed price across its parts (which would risk
  // rounding drift from the amount actually charged).
  productId      String? @map("product_id")
  productName    String  @map("product_name")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  // Which combination was actually bought, if the product has variants.
  // variantLabel is denormalized (e.g. "الحجم: M، اللون: أحمر") so order
  // history/receipts still read correctly even if the variant is edited
  // or deleted later.
  variantId    String? @map("variant_id")
  variantLabel String? @map("variant_label")

  // Set instead of productId when this row is a bundle purchase.
  // bundleName is denormalized like variantLabel above. bundleItemsSnapshot
  // is a display-only [{productName, quantity}] record of what the bundle
  // contained at purchase time — stock decrement for the components happens
  // separately (see /api/orders handler), never derived from this snapshot.
  bundleId            String? @map("bundle_id")
  bundleName          String? @map("bundle_name")
  bundleItemsSnapshot Json?   @map("bundle_items_snapshot")

  order   Order           @relation(fields: [orderId], references: [id])
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  bundle  Bundle?         @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Bundle {
  id         String  @id @default(cuid())
  storeId    String  @map("store_id")
  name       String
  // Fixed combined price for the whole set — never the sum of the
  // components' own priceCents, which is the entire point of a bundle.
  priceCents Int     @map("price_cents")
  imageUrl   String? @map("image_url")
  active     Boolean @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  items      BundleItem[]
  orderItems OrderItem[]
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("bundles")
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String @map("bundle_id")
  productId String @map("product_id")
  // How many units of this product one unit of the bundle contains.
  quantity  Int    @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
}

// A merchant-configured "buyers of X often also want Y" suggestion. Read
// only by the storefront's cart drawer: when a cart line's productId
// matches triggerProductId, the offered product is shown as a small
// add-on suggestion — never auto-added, never a separate checkout step.
model Upsell {
  id               String  @id @default(cuid())
  storeId          String  @map("store_id")
  triggerProductId String  @map("trigger_product_id")
  offeredProductId String  @map("offered_product_id")
  active           Boolean @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  store          Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  triggerProduct Product @relation("UpsellTrigger", fields: [triggerProductId], references: [id], onDelete: Cascade)
  offeredProduct Product @relation("UpsellOffered", fields: [offeredProductId], references: [id], onDelete: Cascade)

  // One configured suggestion per trigger→offered pair, per store — not a
  // hard business requirement, just prevents the dashboard from silently
  // accumulating exact duplicates.
  @@unique([storeId, triggerProductId, offeredProductId])
  @@index([storeId])
  @@index([triggerProductId])
  @@map("upsells")
}

// A merchant's buyer list, derived entirely from real Order history — not
// a separate "add a customer" entity. One row per (storeId, phone),
// upserted inside the exact same transaction that creates an Order (see
// /api/orders), so orderCount/totalSpentCents can never drift from what
// was actually ordered. name/email/city are kept fresh to the buyer's
// most recent order, not frozen at first purchase.
model Customer {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  phone           String
  name            String
  email           String?
  city            String?
  orderCount      Int      @default(0) @map("order_count")
  totalSpentCents Int      @default(0) @map("total_spent_cents")
  lastOrderAt     DateTime @map("last_order_at")
  createdAt       DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

// A merchant-authored static page (About us, Return policy text, etc.) —
// plain text with paragraph breaks only, same safe rendering as
// Product.description. Rendered at /store/{slug}/page/{slug}.
model Page {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  slug      String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("pages")
}

// One flat (not nested) storefront nav link, rendered in header order —
// url can be an internal path (e.g. /page/about) or a full external URL,
// the storefront doesn't distinguish, it just renders an <a href>.
model NavMenuItem {
  id       String @id @default(cuid())
  storeId  String @map("store_id")
  label    String
  url      String
  position Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("nav_menu_items")
}

// A storefront-path redirect (e.g. an old product URL a merchant shared
// externally, now renamed) — checked in src/middleware.ts right after
// slug resolution, folded into the same /api/internal/resolve-domain
// round trip to avoid a second one per request.
model Redirect {
  id       String @id @default(cuid())
  storeId  String @map("store_id")
  fromPath String @map("from_path")
  toPath   String @map("to_path")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fromPath])
  @@index([storeId])
  @@map("redirects")
}
