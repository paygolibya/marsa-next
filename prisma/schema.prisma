// Prisma schema for the Marsa/Rifqa backend.
//
// This is a direct translation of the original better-sqlite3 schema in
// marsa-backend/src/db/index.js — same tables, same columns, same
// relationships and constraints. Field names are camelCase on the Prisma
// side and mapped back to the original snake_case column names via @map,
// so a raw SQL migration from the old SQLite file would line up cleanly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id            String   @id @default(cuid())
  name          String
  nameAr        String
  slug          String   @unique
  description   String
  descriptionAr String
  category      String   @default("all")
  price         Int      @default(0)
  currency      String   @default("LYD")
  billingType   String   @default("free")
  thumbnail     String
  previewUrl    String
  features      Json
  componentPath String?
  defaultColors Json?
  usageCount    Int      @default(0)
  rating        Float    @default(4.5)
  reviews       Int      @default(0)
  featured      Boolean  @default(false)
  isNew         Boolean  @default(false)
  active        Boolean  @default(true)

  stores         Store[]
  customizations TemplateCustomization[]
  reviewsData    TemplateReview[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

model TemplateCustomization {
  id               String  @id @default(cuid())
  storeId          String  @unique @map("store_id")
  templateId       String? @map("template_id")
  primaryColor     String  @default("#0066cc") @map("primary_color")
  secondaryColor   String  @default("#f0f0f0") @map("secondary_color")
  accentColor      String? @map("accent_color")
  logo             String?
  favicon          String?
  tagline          String?
  description      String?
  headerStyle      String  @default("standard") @map("header_style")
  footerStyle      String  @default("standard") @map("footer_style")
  // Deprecated in favor of StoreSection.enabled (per-section, not one flag
  // per section type here) — same fallback-source role as sectionOrder below.
  showNewsletter   Boolean @default(true) @map("show_newsletter")
  showReviews      Boolean @default(true) @map("show_reviews")
  showTestimonials Boolean @default(false) @map("show_testimonials")
  showSocialProof  Boolean @default(true) @map("show_social_proof")
  // Deprecated in favor of StoreSection (see that model's comment) — kept,
  // not dropped, as the fallback source when a store has no StoreSection
  // rows yet (backfill not run / a store created in the gap). New code
  // should read/write StoreSection, not these.
  sectionOrder     String[] @default(["stats", "products", "testimonials", "newsletter"]) @map("section_order")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template_customizations")
}

model TemplateReview {
  id           String  @id @default(cuid())
  templateId   String  @map("template_id")
  merchantId   String? @map("merchant_id")
  rating       Int
  reviewText   String? @map("review_text")
  reviewTextAr String? @map("review_text_ar")
  helpful      Int     @default(0)
  notHelpful   Int     @default(0) @map("not_helpful")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("template_reviews")
}

model Merchant {
  id                     String    @id @default(cuid())
  name                   String
  phone                  String    @unique
  passwordHash           String    @map("password_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  subscriptionTier       String?   @default("basic") @map("subscription_tier")
  subscriptionStatus     String    @default("inactive") @map("subscription_status")
  subscriptionStartDate  DateTime? @map("subscription_start_date")
  subscriptionEndDate    DateTime? @map("subscription_end_date")
  // Which billing period (1/3/12 months) the CURRENT subscriptionEndDate
  // was purchased at — see Payment.periodMonths for the record on each
  // individual payment; this is just "what the merchant is on right now",
  // for dashboard/renewal display. Null for merchants on the free trial
  // or predating this field.
  subscriptionPeriodMonths Int?    @map("subscription_period_months")
  // Set once at registration for new signups (see /api/auth/register).
  // subscriptionEndDate is the one field that actually gates access — this
  // is kept alongside it purely so the UI/admin can tell "still on the
  // free trial" apart from "a real paid period," even after a genuine
  // payment later overwrites subscriptionEndDate to something later.
  trialEndsAt            DateTime? @map("trial_ends_at")
  directWireEnabled      Boolean   @default(true) @map("direct_wire_enabled")
  receiptUploadEnabled   Boolean   @default(true) @map("receipt_upload_enabled")
  codEnabled             Boolean   @default(true) @map("cod_enabled")
  // Name kept from the DPay era for column-rename safety on a live DB —
  // this now gates wallet payment (Moamalat) generally, not DPay
  // specifically. See getCheckoutPaymentMethods().dpay.
  dpayEnabled            Boolean   @default(false) @map("dpay_enabled")
  allowMultiplePaymentMethods Boolean @default(false) @map("allow_multiple_payment_methods")
  apiAccessEnabled       Boolean   @default(false) @map("api_access_enabled")
  selectedPaymentMethod  String?   @map("selected_payment_method")
  // Legacy: DPay's per-merchant bearer token. Moamalat uses app-wide env
  // credentials instead (MOAMALAT_MERCHANT_ID/TERMINAL_ID/SECRET_KEY), so
  // this column is frozen historical data — never read or written by new
  // code.
  dpayApiToken           String?   @map("dpay_api_token")

  phoneVerified          Boolean   @default(false) @map("phone_verified")
  otpCodeHash            String?   @map("otp_code_hash")
  otpExpiresAt           DateTime? @map("otp_expires_at")
  otpSentAt              DateTime? @map("otp_sent_at")
  otpAttempts            Int       @default(0) @map("otp_attempts")
  registrationIp         String?   @map("registration_ip")

  stores Store[]
  payments Payment[]
  payouts Payout[]
  commissions Commission[]
  supportConversations SupportConversation[]
  bugReports BugReport[]

  @@map("merchants")
}

// AI merchant-support chat (Claude, tool-use grounded in this merchant's
// own real data — see src/lib/support/). One conversation persists across
// page reloads; a merchant can escalate a real platform bug mid-conversation
// (see BugReport) rather than the agent guessing or making something up.
model SupportConversation {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]
  bugReports BugReport[]

  @@index([merchantId])
  @@map("support_conversations")
}

model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("support_messages")
}

// A real platform issue the support agent couldn't resolve by answering —
// escalated for a human developer to investigate (see src/app/admin/escalations).
// Deliberately NOT auto-fixed: no agent in this app ever pushes a code
// change to production unattended.
model BugReport {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  storeId        String?  @map("store_id")
  conversationId String?  @map("conversation_id")
  summary        String
  details        String   @db.Text
  status         String   @default("open") // open | investigating | fixed | wont_fix
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  merchant     Merchant             @relation(fields: [merchantId], references: [id])
  conversation SupportConversation? @relation(fields: [conversationId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@map("bug_reports")
}

model Payment {
  id                String    @id @default(cuid())
  merchantId        String    @map("merchant_id")
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  tier              String // legacy — "standard" for every new payment now that there's one plan; kept non-null since old rows have real basic/professional/advanced values
  periodMonths      Int       @default(1) @map("period_months") // 1, 3, or 12 — which billing period this payment is for
  amount            Int // whole LYD, NOT cents — existing convention on this model, kept as-is rather than migrated
  currency          String    @default("LYD")
  status            String    @default("pending") // 'pending' | 'approved' | 'rejected'
  method            String    @default("bank_transfer") @map("method") // 'bank_transfer' | 'dpay' (legacy) | 'moamalat'
  receiptFile       String?   @map("receipt_file")
  receiptUploadedAt DateTime? @map("receipt_uploaded_at")
  approvedAt        DateTime? @map("approved_at")
  approvedBy        String?   @map("approved_by") // admin merchantId for a manual approval; null for an automatic gateway confirmation
  rejectionReason   String?   @map("rejection_reason")

  // Legacy DPay session tracking — frozen historical data, see the
  // matching comment on Order above.
  dpaySessionId String? @unique @map("dpay_session_id")
  dpayPayMethod String? @map("dpay_pay_method")
  dpayFeeCents  Int?    @map("dpay_fee_cents")

  // Direct Moamalat LightBox tracking — see moamalat-subscription.ts.
  // MerchantReference sent to Moamalat is always this Payment's own id.
  moamalatSystemReference  String? @map("moamalat_system_reference")
  moamalatNetworkReference String? @map("moamalat_network_reference")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

model Store {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  name           String
  slug           String   @unique
  theme          String   @default("souk")
  courier        String   @default("vanex") // 'vanex' — Sabil/Shaheen removed, no real integration yet
  codEnabled     Boolean  @default(true) @map("cod_enabled")
  walletProvider String?  @map("wallet_provider") // e.g. 'anis' (DPay aggregator merchant)
  currency       String   @default("LYD")
  templateId     String?  @map("template_id")
  createdAt      DateTime @default(now()) @map("created_at")

  aboutText      String? @map("about_text")
  returnPolicy   String? @map("return_policy")
  shippingPolicy String? @map("shipping_policy")
  businessHours  String? @map("business_hours")

  // Custom domain (e.g. www.merchant-shop.ly) — the {slug}.rifqa.ly
  // subdomain needs no DB field at all, `slug` already is it. Verification
  // is Vercel's own (via its Domains API, src/lib/domains/vercel-client.ts)
  // — customDomainVerified only ever reflects what Vercel itself confirms,
  // never set directly by application logic.
  customDomain         String?  @unique @map("custom_domain")
  customDomainVerified Boolean  @default(false) @map("custom_domain_verified")

  merchant       Merchant               @relation(fields: [merchantId], references: [id])
  template       Template?              @relation(fields: [templateId], references: [id])
  customization  TemplateCustomization?
  products       Product[]
  orders         Order[]
  coupons        Coupon[]
  newsletterSubscribers NewsletterSubscriber[]
  sections       StoreSection[]

  @@map("stores")
}

// Replaces TemplateCustomization's flat sectionOrder: String[] + the four
// show* booleans with a real, individually-configurable content model — one
// row per section instead of one shared array. `settings` is validated
// per-`type` by the Zod schemas in
// src/components/storefront/sections/schemas.ts (kept intentionally small:
// these sections stay data-driven — real orders/reviews/products — not
// merchant-authored CMS content; that's the seam future section types would
// plug into, not something Phase 1 needs).
//
// Additive-only migration (prisma/migrations/*_add_store_sections) — safe
// on live production data on its own. A one-time backfill script
// (prisma/scripts/backfill-store-sections.ts) populates this table from
// each store's existing sectionOrder/show* fields; until that's run for a
// given store (or for a store created in the gap before it runs), storefront
// rendering falls back to synthesizing sections in-memory from those legacy
// fields — see normalizeSectionOrder() — so the rollout order isn't required
// to be atomic. The legacy sectionOrder/show* columns are deliberately NOT
// dropped here — a later migration removes them once this table's been the
// live source for a while.
model StoreSection {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  type      String   // "stats" | "products" | "testimonials" | "newsletter" for now
  position  Int
  enabled   Boolean  @default(true)
  settings  Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, position])
  @@index([storeId])
  @@map("store_sections")
}

// Real capture behind the customizer's "عرض نموذج الاشتراك بالرسائل"
// toggle — previously a checkbox with nothing behind it at all.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@map("newsletter_subscribers")
}

model Product {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  name       String
  priceCents Int      @map("price_cents")
  // imageUrl is kept as images[0] — always written together, never a
  // second source of truth — so every existing call site that only knows
  // about a single image (storefront template cards, cart, order emails)
  // keeps working unchanged; only the product detail page and the editor
  // need the full gallery.
  imageUrl   String?  @map("image_url")
  images     String[] @default([])
  // `active` is ALSO auto-set to false by /api/orders when stock hits 0
  // (see the stock-decrement transaction) — not only by a merchant's own
  // delete. deletedAt is the one unambiguous "the merchant deleted this"
  // signal, so the merchant's own product list (GET /by-store) can filter
  // out deleted products while still showing out-of-stock ones (which the
  // merchant needs to see, to restock). The public storefront listing
  // still just checks active — a buyer should never see either case.
  active     Boolean   @default(true)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  trackInventory    Boolean @default(false) @map("track_inventory")
  stockQty          Int     @default(0) @map("stock_qty")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")

  // Option TYPES this product offers, e.g.
  // [{"name":"الحجم","values":["S","M","L"]},{"name":"اللون","values":["أحمر","أزرق"]}]
  // — null/empty means no variants, same as today. The actual purchasable
  // combinations are ProductVariant rows; this is only the merchant's
  // editable option definitions used to generate/regenerate them.
  variantOptions Json? @map("variant_options")

  store      Store            @relation(fields: [storeId], references: [id])
  orderItems OrderItem[]
  reviews    ProductReview[]
  variants   ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  // e.g. {"الحجم":"M","اللون":"أحمر"} — one concrete combination of the
  // parent product's variantOptions.
  options   Json
  // null = inherit Product.priceCents; set only when this specific
  // combination costs more/less than the base product.
  priceCents Int?   @map("price_cents")
  stockQty  Int     @default(0) @map("stock_qty")
  sku       String?
  active    Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model Order {
  id                String   @id @default(cuid())
  storeId           String   @map("store_id")
  buyerName         String   @map("buyer_name")
  buyerPhone        String   @map("buyer_phone")
  buyerEmail        String?  @map("buyer_email")
  buyerCity         String   @map("buyer_city")
  buyerAddress      String   @map("buyer_address")
  paymentMethod     String   @map("payment_method") // 'cod' | 'wallet'
  paymentStatus     String   @map("payment_status") // 'pending' | 'paid' | 'failed'
  courierTrackingId String?  @map("courier_tracking_id")
  status            String   @default("pending") // pending -> confirmed -> shipped -> delivered -> cancelled
  productSubtotalCents Int   @default(0) @map("product_subtotal_cents")
  discountCents     Int      @default(0) @map("discount_cents")
  couponCode        String?  @map("coupon_code")
  totalCents        Int      @map("total_cents")
  shippingCents     Int      @default(0) @map("shipping_cents")
  courierStatus     String?  @map("courier_status") // raw courier-reported status, e.g. accepted/delivered/failed_delivery/returned
  courierStatusAt   DateTime? @map("courier_status_at")
  courierNote       String?  @map("courier_note") // failure/return reason from the courier
  createdAt         DateTime @default(now()) @map("created_at")

  // Legacy DPay wallet payment tracking — DPay (the aggregator) was
  // removed in favor of a direct Moamalat integration; these three
  // columns are frozen historical data for orders paid before that
  // switch, never written to by new code. See moamalatSystemReference
  // etc. below for the current integration.
  dpaySessionId String? @unique @map("dpay_session_id")
  dpayPayMethod String? @map("dpay_pay_method") // edfali | sadad | masrefypay | yousrpay | saharapay | mobicash | moamalat
  dpayFeeCents  Int?    @map("dpay_fee_cents") // DPay's own fee, separate from Rifqa's commission

  // Direct Moamalat LightBox payment tracking — set once Moamalat's
  // completeCallback or server notification confirms the transaction
  // (src/lib/payment/moamalat-client.ts). paymentStatus flips from
  // pending to paid/failed only via src/lib/payment/moamalat-order.ts,
  // called from either the client-relayed complete callback or Moamalat's
  // own server notification (whichever confirms first) — never written
  // directly anywhere else. MerchantReference sent to Moamalat is always
  // this Order's own id, so no separate correlation column is needed.
  moamalatSystemReference  String? @map("moamalat_system_reference")
  moamalatNetworkReference String? @map("moamalat_network_reference")

  // Automatic payout tracking — set the moment the real-time trigger (or
  // its daily-cron backstop) calculates this order's commission. Denormalized
  // copies of the linked Commission row so the order itself is queryable
  // without a join; see src/lib/payment/payout-processor.ts.
  rifqaCommissionCents Int?      @map("rifqa_commission_cents")
  merchantPayoutCents  Int?      @map("merchant_payout_cents")
  payoutStatus         String?   @map("payout_status") // null (not yet calculated) | 'ready_for_transfer' | 'transferred'
  payoutCalculatedAt   DateTime? @map("payout_calculated_at")
  payoutTransferredAt  DateTime? @map("payout_transferred_at")

  vanexAreaId String?     @map("vanex_area_id")
  vanexArea   VanexArea?  @relation(fields: [vanexAreaId], references: [id], onDelete: SetNull)

  store      Store           @relation(fields: [storeId], references: [id])
  items      OrderItem[]
  reviews    ProductReview[]
  commission Commission?

  @@map("orders")
}

// ============================================
// PAYOUTS — automatic commission/payout tracking
//
// Only orders where Rifqa actually held the money are eligible: wallet
// (DPay) orders with paymentStatus "paid". COD cash is collected by the
// courier directly from the buyer and never touches Rifqa's account, so
// there is nothing to pay a merchant out of for a COD order through this
// system — see src/lib/payment/commission.ts for the exact filter.
//
// Commission = one row per eligible order, created automatically the
// moment it's marked delivered (real-time trigger) or, as a backstop, by
// the daily cron. Payout = a weekly batch of Commission rows for one
// merchant, created by the Friday cron and manually transferred by an
// admin — see src/lib/payment/payout-processor.ts.
// ============================================

model Commission {
  id                   String    @id @default(cuid())
  orderId              String    @unique @map("order_id")
  merchantId           String    @map("merchant_id")
  payoutId             String?   @map("payout_id")
  orderTotalCents      Int       @map("order_total_cents")
  rifqaCommissionCents Int       @map("rifqa_commission_cents")
  merchantPayoutCents  Int       @map("merchant_payout_cents")
  status               String    @default("calculated") @map("status") // 'calculated' | 'paid'
  calculatedAt         DateTime  @default(now()) @map("calculated_at")
  paidAt               DateTime? @map("paid_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payout   Payout?  @relation(fields: [payoutId], references: [id])

  @@map("commissions")
}

model Payout {
  id                String    @id @default(cuid())
  merchantId        String    @map("merchant_id")
  periodStart       DateTime  @map("period_start")
  periodEnd         DateTime  @map("period_end")
  orderCount        Int       @map("order_count")
  totalSalesCents   Int       @map("total_sales_cents")
  commissionCents   Int       @map("commission_cents")
  amountCents       Int       @map("amount_cents") // what the merchant actually receives
  status            String    @default("ready_for_transfer") @map("status") // 'ready_for_transfer' | 'transferred'
  transferredAt     DateTime? @map("transferred_at")
  transferredBy     String?   @map("transferred_by") // admin merchantId who clicked transfer
  transferReference String?   @map("transfer_reference") // bank ref / note for the manual transfer
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@map("payouts")
}

model CronLog {
  id              String   @id @default(cuid())
  jobName         String   @map("job_name") // 'process-deliveries' | 'weekly-payouts'
  status          String   // 'success' | 'failed'
  ordersProcessed Int      @default(0) @map("orders_processed")
  payoutsCreated  Int      @default(0) @map("payouts_created")
  errorMessage    String?  @map("error_message")
  durationMs      Int?     @map("duration_ms")
  executedAt      DateTime @default(now()) @map("executed_at")

  @@map("cron_logs")
}

model Coupon {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  code          String
  discountType  String    @map("discount_type") // 'percent' | 'fixed'
  discountValue Int       @map("discount_value") // percent: 1-100; fixed: cents
  minOrderCents Int?      @map("min_order_cents")
  maxUsage      Int?      @map("max_usage")
  usageCount    Int       @default(0) @map("usage_count")
  active        Boolean   @default(true)
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@map("coupons")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  orderId    String   @map("order_id")
  buyerName  String   @map("buyer_name")
  buyerPhone String   @map("buyer_phone") // spam-gate re-check only, never returned by the public GET
  rating     Int
  reviewText String?  @map("review_text")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@map("product_reviews")
}

// ============================================
// VANEX SHIPPING INTEGRATION
// ============================================

model VanexCity {
  id         String   @id @default(cuid())
  vanexId    Int      @unique @map("vanex_id")
  name       String
  priceCents Int      @map("price_cents")
  code       String
  branch     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  areas VanexArea[]

  @@map("vanex_cities")
}

model VanexArea {
  id         String   @id @default(cuid())
  vanexId    Int      @unique @map("vanex_id")
  cityId     String   @map("city_id")
  name       String
  priceCents Int      @map("price_cents")
  code       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  city   VanexCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([cityId])
  @@map("vanex_areas")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  productName    String  @map("product_name")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  // Which combination was actually bought, if the product has variants.
  // variantLabel is denormalized (e.g. "الحجم: M، اللون: أحمر") so order
  // history/receipts still read correctly even if the variant is edited
  // or deleted later.
  variantId    String? @map("variant_id")
  variantLabel String? @map("variant_label")

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
